# ---------- Database ----------
POSTGRES_USER=gym
# Use a strong password (8+ characters). The backend refuses to start with a weak one.
POSTGRES_PASSWORD=gymsecret123
POSTGRES_DB=gymdb

# ---------- Security ----------
# Required: at least 32 random characters, no dictionary words.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Set to "production" on a live server (adds the Secure cookie flag, stricter CORS)
NODE_ENV=development

# Comma-separated list of allowed browser origins (leave empty to allow APP_URL only)
FRONTEND_ORIGINS=

# First admin account, created automatically when none exists.
# Required on a fresh install; on an existing install you can leave these empty.
BOOTSTRAP_ADMIN_EMAIL=admin@yourgym.com
BOOTSTRAP_ADMIN_PASSWORD=

# ---------- SaaS platform ----------
# Root domain of the platform (gym subdomains hang off this). Deploy to real
# VPS only; leave empty in local dev.
PLATFORM_DOMAIN=
CADDY_EMAIL=              # email for Let's Encrypt (only in docker-compose.prod.yml)
TRIAL_DAYS=14             # free trial length for new gyms

# Manages every gym (list / suspend / mark paid). Optional until you need it.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# Platform fee — automatic monthly collection per gym.
# 1. In the Razorpay dashboard (the platform's own account) create a recurring
#    Plan (e.g. ₹499/month) → copy its id (starts with "plan_")
# 2. Put it here; then use "Auto-fee" in the platform admin panel — Razorpay
#    emails each gym owner a payment link and charges extend paid_until automatically.
PLATFORM_RZP_PLAN_ID=

# ---------- Email sending (a Gmail app-password works too) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---------- WhatsApp Business Cloud API ----------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ---------- Public address of the app ----------
# This link is used in outgoing messages (e.g. password-reset links)
APP_URL=http://jainifitness.test

# ---------- Razorpay (get test/live keys from dashboard.razorpay.com) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret from your Razorpay dashboard (Settings → Webhooks)
RAZORPAY_WEBHOOK_SECRET=